# Used by docker-compose.prod.yml (umbrella mode — shared Postgres + network).
# The dev/solo flow uses .env.example with docker-compose.yml.

# Shared infra Postgres — must match ../infra/.env (devtools/devtools is the
# DevTools-wide convention; the API connection string is built from these
# three vars by docker-compose.prod.yml).
POSTGRES_USER=devtools
POSTGRES_PASSWORD=devtools
POSTGRES_DB=devhub

# JWT — required. SigningKey must be a 32+ byte random string in production.
Jwt__Issuer=https://devhub.local
Jwt__Audience=devhub-spa
Jwt__SigningKey=replace-me-with-at-least-32-byte-random-string

# Seeded operator (created at first boot only — rotate the password
# immediately and treat the seed as bootstrap-only).
OperatorSeed__Email=operator@devhub.local
OperatorSeed__DisplayName=Operator
OperatorSeed__Password=replace-me-and-rotate-immediately

# CORS — MUST match WEB_HOST_PORT exactly (scheme + host + port).
# If you change WEB_HOST_PORT below, change this in lockstep.
Cors__SpaOrigin=http://127.0.0.1:4300

# Host port bindings — loopback only.
#   - UIs live on the 4xxx band (ao-ui:4200, devhub-web:4300, ...).
#   - APIs live on the 8xxx band (orchestrator-api:8000, devhub-api:8090, ...).
# Peers on the shared infra network reach this stack as
# `devhub-web:80` and `devhub-api:8080` regardless of these host ports.
WEB_HOST_PORT=4300
API_HOST_PORT=8090
